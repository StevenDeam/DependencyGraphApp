<Window x:Class="DependencyDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DependencyDashboard.App.Controls"
        Title="{Binding WindowTitle}"
        Height="800" Width="1400"
        WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Open CSV and Zoom -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open CSV" Command="{Binding OpenCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Reload (F5)" Command="{Binding ReloadCommand}" Padding="12,6"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Gray"/>
                    <Button Content="{Binding FitToScreenButtonText}"
                            Command="{Binding ToggleFitToScreenCommand}"
                            Padding="12,6"
                            ToolTip="Toggle fit-to-screen view"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Legend Only -->
            <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="Legend" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="Status Colors:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Not Started"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="12" Height="12" Fill="DodgerBlue" Margin="0,0,8,0"/>
                            <TextBlock Text="In Progress"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="12" Height="12" Fill="OrangeRed" Margin="0,0,8,0"/>
                            <TextBlock Text="Blocked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="12" Height="12" Fill="Green" Margin="0,0,8,0"/>
                            <TextBlock Text="Done"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Health:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse Width="12" Height="12" Fill="Green" Margin="0,0,8,0"/>
                            <TextBlock Text="On Track"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse Width="12" Height="12" Fill="Orange" Margin="0,0,8,0"/>
                            <TextBlock Text="At Risk"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                            <TextBlock Text="Critical"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Center: Phase Matrix View -->
            <Grid Grid.Column="1">
                <!-- Error Panel -->
                <Border Background="#FFF0F0" BorderBrush="Red" BorderThickness="1"
                        Padding="12" Margin="12" VerticalAlignment="Top"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Validation Errors" FontWeight="Bold" Foreground="Red" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ValidationErrors}" MaxHeight="200">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Graph Canvas with ScrollViewer -->
                <ScrollViewer x:Name="GraphScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                              Background="White">
                    <controls:GraphCanvas x:Name="GraphCanvas"
                                          WorkItems="{Binding WorkItems}"
                                          PhaseColumns="{Binding PhaseColumns}"
                                          MilestoneEdges="{Binding MilestoneEdges}">
                        <controls:GraphCanvas.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                        </controls:GraphCanvas.LayoutTransform>
                    </controls:GraphCanvas>
                </ScrollViewer>

                <!-- Empty State -->
                <TextBlock Text="Open a CSV file to view the Phase Matrix"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="16"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"/>
        </Border>
    </Grid>
</Window>
