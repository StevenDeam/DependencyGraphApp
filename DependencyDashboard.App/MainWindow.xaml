<Window x:Class="DependencyDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DependencyDashboard.App"
        xmlns:vm="clr-namespace:DependencyDashboard.App.ViewModels"
        xmlns:controls="clr-namespace:DependencyDashboard.App.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1400"
        WindowState="Maximized">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ResetViewCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Command Bar -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel>
                <!-- Left: File commands -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Open CSV" Command="{Binding OpenCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Reload (F5)" Command="{Binding ReloadCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                    <Button Content="Export PNG" Command="{Binding ExportPngCommand}" Padding="12,6" Margin="0,0,8,0" Click="ExportPng_Click"/>
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Padding="12,6" Margin="0,0,8,0" Click="ExportPdf_Click"/>
                </StackPanel>

                <!-- Right: Search and toggles -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Padding="4" VerticalContentAlignment="Center"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="16,0"/>
                    <CheckBox Content="Milestones Only"
                              IsChecked="{Binding ShowMilestonesOnly}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox Content="Blocked Paths Only"
                              IsChecked="{Binding ShowBlockedPathsOnly}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                    <TextBlock Text="Layout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton Content="Bracket" IsChecked="{Binding IsBracketMode}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" GroupName="LayoutMode"/>
                    <RadioButton Content="Swimlanes" IsChecked="{Binding IsSwimlaneMode}"
                                 VerticalAlignment="Center" GroupName="LayoutMode"/>
                </StackPanel>

                <!-- Center: Zoom controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="-" Command="{Binding ZoomOutCommand}" Width="30" Padding="4"/>
                    <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}"
                               VerticalAlignment="Center" Margin="8,0" Width="50" TextAlignment="Center"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Width="30" Padding="4"/>
                    <Button Content="Reset" Command="{Binding ResetViewCommand}" Padding="8,4" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Filters -->
            <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Filters" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                        <!-- Discipline Filter -->
                        <TextBlock Text="Discipline" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DisciplineFilters}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Status Filter -->
                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding StatusFilters}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Health Filter -->
                        <TextBlock Text="Health (Milestones)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding HealthFilters}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}"
                                Padding="8,4" Margin="0,8,0,0"/>

                        <!-- Legend -->
                        <TextBlock Text="Legend" FontWeight="Bold" FontSize="14" Margin="0,24,0,12"/>

                        <TextBlock Text="Status Colors:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                                <TextBlock Text="Not Started"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" Fill="DodgerBlue" Margin="0,0,8,0"/>
                                <TextBlock Text="In Progress"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" Fill="OrangeRed" Margin="0,0,8,0"/>
                                <TextBlock Text="Blocked"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" Fill="Green" Margin="0,0,8,0"/>
                                <TextBlock Text="Done"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Health Indicators:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="Green" Margin="0,0,8,0"/>
                                <TextBlock Text="On Track"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="Orange" Margin="0,0,8,0"/>
                                <TextBlock Text="At Risk"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                                <TextBlock Text="Critical"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center: Graph View with Tabs -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Graph View Tab -->
                <TabItem Header="Dependency Graph">
                    <Grid>
                        <!-- Error Panel -->
                        <Border Background="#FFF0F0" BorderBrush="Red" BorderThickness="1"
                                Padding="12" Margin="12"
                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Validation Errors" FontWeight="Bold" Foreground="Red" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ValidationErrors}" MaxHeight="200">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Graph Canvas with ScrollViewer -->
                        <ScrollViewer x:Name="GraphScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Background="#FAFAFA">
                            <controls:GraphCanvas x:Name="GraphCanvas"
                                                  WorkItems="{Binding FilteredWorkItems}"
                                                  Edges="{Binding FilteredEdges}"
                                                  SwimLanes="{Binding SwimLanes}"
                                                  LayoutMode="{Binding LayoutMode}"
                                                  ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                                  PanX="{Binding PanX, Mode=TwoWay}"
                                                  PanY="{Binding PanY, Mode=TwoWay}"
                                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <TextBlock Text="Open a CSV file to view the dependency graph"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontSize="16"
                                   Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </Grid>
                </TabItem>

                <!-- Milestone Dashboard Tab -->
                <TabItem Header="Milestone Dashboard">
                    <DataGrid ItemsSource="{Binding MilestoneItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Milestone" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Target Date" Binding="{Binding DisplayTargetDate}" Width="100"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding DisplayPercent}" Width="80"/>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="4,2">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Health" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="{Binding HealthBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding HealthText}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Blocked" Binding="{Binding BlockedCount}" Width="70"/>
                            <DataGridTextColumn Header="Top Blocker" Binding="{Binding TopBlockerDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- Right Panel: Inspector -->
            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" DataContext="{Binding}">
                        <TextBlock Text="Inspector" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                        <!-- No Selection State -->
                        <TextBlock Text="Select a node to view details"
                                   Foreground="Gray" FontStyle="Italic"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- Selection Details -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Summary Section -->
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                                    CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItem.Title}" FontWeight="Bold" FontSize="14"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedItem.Id}" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" Foreground="Gray"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.Type}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Discipline:" Foreground="Gray"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Discipline}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Foreground="Gray"/>
                                        <Border Grid.Row="2" Grid.Column="1" Background="{Binding SelectedItem.StatusBrush}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding SelectedItem.StatusText}" Foreground="White" FontSize="11"/>
                                        </Border>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Progress:" Foreground="Gray" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.DisplayPercent}"
                                                   FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Target:" Foreground="Gray"
                                                   Visibility="{Binding SelectedItem.IsMilestone, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.DisplayTargetDate}"
                                                   Visibility="{Binding SelectedItem.IsMilestone, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Health:" Foreground="Gray"
                                                   Visibility="{Binding SelectedItem.IsMilestone, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                                                    Visibility="{Binding SelectedItem.IsMilestone, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Ellipse Width="12" Height="12" Fill="{Binding SelectedItem.HealthBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding SelectedItem.HealthText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Blocked By -->
                            <Border Background="#FFF5E5" BorderBrush="Orange" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedItem.BlockedById, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Blocked By:" FontWeight="SemiBold" Foreground="OrangeRed"/>
                                    <TextBlock Text="{Binding SelectedItem.BlockedById}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Prerequisite Section -->
                            <TextBlock Text="Prerequisite" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="None" Foreground="Gray" FontStyle="Italic"
                                               Visibility="{Binding SelectedItem.PrereqId, Converter={StaticResource NullToVisibilityConverterInverse}}"/>
                                    <StackPanel Visibility="{Binding SelectedItem.PrereqId, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedItem.Model.Prerequisite.Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedItem.PrereqId}" Foreground="Gray" FontSize="11"/>
                                        <Button Content="Jump to" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Padding="8,2" Click="JumpToPrereq_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Dependents Section -->
                            <TextBlock Text="Dependents" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Margin="0,0,0,12" MaxHeight="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Model.Dependents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalAlignment="Left" Margin="0,2"
                                                        Background="Transparent" BorderThickness="0"
                                                        Click="JumpToDependent_Click" Tag="{Binding Id}">
                                                    <TextBlock>
                                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        <Run Text=" (" Foreground="Gray"/><Run Text="{Binding Id, Mode=OneWay}" Foreground="Gray"/><Run Text=")" Foreground="Gray"/>
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Children Section -->
                            <TextBlock Text="Children" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Margin="0,0,0,12" MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Model.Children}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2" Padding="4" Background="#F8F8F8" CornerRadius="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Id}" Foreground="Gray" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Run Text="{Binding ComputedPercent, StringFormat='{}{0:F0}%', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"/>
        </Border>
    </Grid>
</Window>
